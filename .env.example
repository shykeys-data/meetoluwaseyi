# Copy to .env for local development. Hosts set these as real environment variables.
# Development runs with none of them set. Staging and production refuse to start
# if a required one is missing (see src/server/config.ts).
# Keep comments on their own lines: text after a value becomes part of the value.

# development | production (staging also runs as production)
NODE_ENV=development
# development | staging | production
APP_ENV=development
PORT=3000
# https://meetoluwaseyi.com in production, https://staging.meetoluwaseyi.com on staging
SITE_URL=http://localhost:3000

# --- Required on staging and production ---
# mysql://user:password@localhost:3306/database
DATABASE_URL=
# 32+ random characters, e.g. the output of: openssl rand -base64 48
SESSION_SECRET=
# 16+ random characters
IP_HASH_SALT=
ADMIN_EMAIL=

# --- Staging only: the whole site sits behind this login (password 12+ characters) ---
STAGING_USER=preview
STAGING_PASSWORD=

# --- Services: optional now, each becomes required in the phase that ships it ---
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Your WhatsApp number for alerts: server-side only, never shown on the site
WHATSAPP_TO=
TURNSTILE_SECRET=
# Optional: raises the GitHub API rate limit for the project sync
GITHUB_TOKEN=
MAIL_FROM=
WHATSAPP_TEMPLATE=new_message
TURNSTILE_SITE_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ADMIN_PATH=/fixoluwaseyi
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
