{
  "name": "meetoluwaseyi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "meetoluwaseyi.com: personal brand site for Oluwaseyi Oshunwusi. React + Express + Node + MySQL, two moods (playful and serious).",
  "author": "Oluwaseyi Oshunwusi (https://github.com/shykeys-data)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && vite build --ssr src/server/index.ts --outDir dist/server && vite build --ssr src/server/jobs/cli.ts --outDir dist/jobs",
    "start": "node dist/server/index.js",
    "db:migrate": "node dist/jobs/cli.js migrate",
    "db:seed": "node dist/jobs/cli.js seed",
    "admin:create": "node dist/jobs/cli.js create-admin",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.37.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
